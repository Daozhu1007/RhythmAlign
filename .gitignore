# Python virtual environment
.venv/

# Bytecode cache
__pycache__/
*.pyc
*.pyo

# PyInstaller build artifacts
build/
dist/
release/

# IDE settings
.idea/

# Local experiment scratch outputs (audio caches, frames, large JSON/NPY)
/results/

# Local real-corpus manifest (contains personal media paths — never commit)
experiments/low_snr_alignment/local_corpus.json
experiments/low_snr_alignment/local_sources.json

# Applied-system research working data (raw/personal/copyrighted audio and
# local QC artifacts). Owned by research/applied-system-paper, which carries
# its own nested .gitignore rules; never commit from main.
experiments/applied_system/

# System files
Thumbs.db
Desktop.ini

# ZCode local tool config (auto-synced from .gitignore; machine-local)
.zcodeignore
